{
  "threshold": 0,
  "minLines": 5,
  "minTokens": 50,
  "reporters": ["console"],
  "ignore": [
    "**/node_modules/**",
    "**/styled-system/**",
    "**/.react-router/**",
    "**/build/**",
    "**/dist/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/.agents/**",
    "**/.wireit/**",
    "**/.wrangler/**",
    "**/drizzle/**",
    "**/playwright-report/**",
