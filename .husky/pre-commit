#!/usr/bin/env sh

# Block modifications to protected configuration and linter scripts without explicit approval
node scripts/verify-config-lock.ts

# Mechanically enforce TDD: require tests when src/ or scripts/ is modified
node scripts/verify-tdd-staged.ts

# Surgical staged-file enforcement via lint-staged (with ESLint + Prettier metadata caches)
pnpm exec lint-staged

# Tier 2 (Serious Commit Gate): single parallel Wireit graph with incremental & metadata caches
pnpm run check:commit

