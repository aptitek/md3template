#!/usr/bin/env sh

# Mechanically enforce TDD: require tests when src/ is modified
node scripts/verify-tdd-staged.mjs

# Surgical staged-file enforcement via lint-staged (with ESLint + Prettier metadata caches)
pnpm exec lint-staged

# Incremental TypeScript type-check, secret-scanner, zero-duplication (jscpd), CSF3 story, route hierarchy, & boundary checks (cached via Wireit)
pnpm run lint:secrets
pnpm run lint:jscpd
pnpm run lint:storybook
pnpm run lint:routes
pnpm run lint:typecheck
pnpm run lint:boundaries


