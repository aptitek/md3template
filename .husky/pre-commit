#!/usr/bin/env sh

# Mechanically enforce TDD: require tests when src/ is modified
node scripts/verify-tdd-staged.mjs

# Surgical staged-file enforcement via lint-staged (with ESLint + Prettier metadata caches)
pnpm exec lint-staged

# Incremental TypeScript type-check & strategic error boundary check (cached via Wireit + tsbuildinfo)
pnpm run lint:typecheck
pnpm run lint:boundaries
