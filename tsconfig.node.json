{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "react-router.config.ts",
    "panda.config.ts",
    "drizzle.config.ts",
    "src/tokens/md3.ts",
    "src/types/**/*.d.ts",
    "scripts/**/*",
    ".storybook/**/*"
  ],
  "compilerOptions": {
    "strict": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/node.tsbuildinfo",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler"
  }
}
