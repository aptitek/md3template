{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}!",
    "src/**/*.stories.{ts,tsx}",
    ".storybook/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs}"
  ],
  "project": [
    "src/**/*.{ts,tsx,mdx}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs}"
  ],
  "ignoreDependencies": [
    "@cloudflare/vitest-plugin",
    "@react-router/node",
    "@secretlint/secretlint-rule-preset-recommend",
    "@sonar/scan",
    "@testing-library/react",
    "@testing-library/user-event",
    "drizzle-zod",
    "eslint-import-resolver-node",
    "i18next",
    "i18next-browser-languagedetector",
    "react-i18next",
    "rehype-react",
    "remark-directive",
    "remark-parse",
    "remark-rehype",
    "secretlint",
    "unified",
    "vfile"
  ],
  "ignoreBinaries": ["snyk"]
}
