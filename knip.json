{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/routes/**/*.{ts,tsx}!",
    "src/**/*.stories.{ts,tsx}",
    ".storybook/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,mdx}",
    "tests/**/*.{ts,tsx}",
    "scripts/**/*.ts"
  ],
  "ignoreDependencies": [
    "@react-router/node",
    "@secretlint/secretlint-rule-preset-recommend",
    "@sonar/scan",
    "eslint-import-resolver-node",
    "secretlint"
  ],
  "ignoreBinaries": ["snyk"]
}
